          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "suppliers"
          ]
        }
      }
    },
    {
      "name": "List purchase orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/purchase-orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "purchase-orders"
          ]
        }
      }
    },
    {
      "name": "Create purchase order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/purchase-orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "purchase-orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"product_id\": 1, \"supplier_id\": 1, \"qty\": 100}"
        }
      }
    },
    {
      "name": "Policy question",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/rag/query",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "rag",
            "query"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"question\": \"What is the reorder point formula?\"}"
        }
      }
    },
    {
      "name": "Run agents",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/agents/run",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "agents",
            "run"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('run_id', pm.response.json().run_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get run",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/agents/runs/{{run_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "agents",
            "runs",
            "{{run_id}}"
          ]
        }
      }
    },
    {
      "name": "List recommendations",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/recommendations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recommendations"
          ]
        }
      }
    },
    {
      "name": "Approve recommendation",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/recommendations/1/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recommendations",
            "1",
            "approve"
          ]
        }
      }
    },
    {
      "name": "Reject recommendation",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/recommendations/2/reject",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recommendations",
            "2",
            "reject"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "run_id",
      "value": ""
    }
  ]
