# Postgres in production; leave empty locally to use SQLite
DATABASE_URL=postgresql://user:pass@localhost:5432/supply
# Optional: leave empty to use an in-memory cache
REDIS_URL=redis://localhost:6379/0
# Set ONE of these to enable the LLM (without one, the agents use rule-based explanations)
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL=
